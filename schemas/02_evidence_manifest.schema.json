{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidenceManifest",
  "type": "object",
  "required": [
    "id", "type", "producer_agent", "generated_patch_ref", "intoto_envelope_ref",
    "slsa_provenance_ref", "ai_evidence", "dependency_lock_ref", "runtime_descriptor",
    "reproducibility", "evidence_payload_ref", "integrity_signature"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "type": {"const": "EvidenceManifest"},
    "producer_agent": {"type": "string"},
    "generated_patch_ref": {"type": "string"},
    "intoto_envelope_ref": {"type": "string", "minLength": 1},
    "slsa_provenance_ref": {"type": "string", "minLength": 1},
    "ai_evidence": {"type": "object"},
    "dependency_lock_ref": {"type": "string", "minLength": 1},
    "runtime_descriptor": {
      "type": "object",
      "required": ["implementation", "language", "version", "build", "gil", "platform"],
      "properties": {
        "implementation": {"type": "string"},
        "language": {"type": "string"},
        "version": {"type": "string"},
        "build": {
          "type": "object",
          "required": ["free_threaded"],
          "properties": {"free_threaded": {"type": "boolean"}, "build_flags": {"type": "array"}},
          "additionalProperties": true
        },
        "gil": {
          "type": "object",
          "required": ["build_supports_free_threading", "runtime_gil_requested", "runtime_gil_observed", "observation_method"],
          "properties": {
            "build_supports_free_threading": {"type": "boolean"},
            "runtime_gil_requested": {"type": ["boolean", "null"]},
            "runtime_gil_observed": {"type": ["boolean", "null"]},
            "observation_method": {"type": "string"}
          },
          "additionalProperties": true
        },
        "platform": {"type": "string"}
      },
      "additionalProperties": true
    },
    "reproducibility": {
      "type": "object",
      "required": ["level", "artifact_identity", "comparison"],
      "properties": {
        "level": {"enum": ["NOT_REPRODUCIBLE", "REPRODUCIBLE", "VERIFIED_REPRODUCIBLE"]},
        "artifact_identity": {"type": ["string", "null"]},
        "comparison": {"type": "object"}
      },
      "additionalProperties": true
    },
    "evidence_payload_ref": {"type": "string", "minLength": 1},
    "integrity_signature": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
